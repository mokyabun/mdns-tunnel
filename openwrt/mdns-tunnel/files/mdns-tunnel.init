#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

PROG=/usr/sbin/mdns-tunnel

append_service() {
	services="${services:+$services,}$1"
}

start_service() {
	local enabled network listen_network listen_port log_level iface listen_ip services

	config_load mdns-tunnel
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0

	config_get network main network lan
	config_get listen_network main listen_network wg0
	config_get listen_port main listen_port 5354
	config_get log_level main log_level info
	config_list_foreach main service append_service

	. /lib/functions/network.sh
	# The interface triggers start the relay once the missing interface comes up.
	network_get_device iface "$network" || {
		logger -t mdns-tunnel "interface $network is not up, waiting"
		return 0
	}
	network_get_ipaddr listen_ip "$listen_network" || {
		logger -t mdns-tunnel "interface $listen_network has no IPv4 address, waiting"
		return 0
	}

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env IFACE="$iface" LISTEN="$listen_ip:$listen_port" \
		SERVICES="$services" LOG_LEVEL="$log_level"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	local network listen_network

	config_load mdns-tunnel
	config_get network main network lan
	config_get listen_network main listen_network wg0

	procd_add_reload_trigger mdns-tunnel
	# Reload, not restart: interface.update events must not drop a working tunnel.
	procd_add_reload_interface_trigger "$network"
	procd_add_reload_interface_trigger "$listen_network"
}
