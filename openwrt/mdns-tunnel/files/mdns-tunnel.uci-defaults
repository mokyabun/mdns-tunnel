#!/bin/sh

zone="$(uci -q get mdns-tunnel.main.fw_zone)"
port="$(uci -q get mdns-tunnel.main.listen_port)"
[ -n "$zone" ] && [ -n "$port" ] || exit 0

# A named section keeps reinstalls idempotent and lets postrm find the rule.
uci -q get firewall.mdns_tunnel >/dev/null && exit 0

uci batch <<EOF
set firewall.mdns_tunnel=rule
set firewall.mdns_tunnel.name='Allow-mdns-tunnel'
set firewall.mdns_tunnel.src='$zone'
set firewall.mdns_tunnel.proto='tcp'
set firewall.mdns_tunnel.dest_port='$port'
set firewall.mdns_tunnel.target='ACCEPT'
EOF
uci commit firewall
/etc/init.d/firewall reload >/dev/null 2>&1

exit 0
